@model System.Collections.Generic.IList<Nop.Plugin.Misc.MultiTenantStores.Domain.BnplCredential>

@{
    Layout = "_AdminLayout";
    ViewBag.Title = "پرداخت اعتباری (دیجی‌پی / اسنپ‌پی)";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        پرداخت اعتباری (BNPL)
        <small><i class="fas fa-credit-card"></i> دیجی‌پی / اسنپ‌پی</small>
    </h1>
    <div class="float-right">
        <a asp-action="Edit" class="btn bg-blue">
            <i class="fas fa-plus-square"></i> افزودن جدید
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>ارائه‌دهنده</th>
                            <th>محیط</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center">هنوز اعتبارنامه‌ای ثبت نشده است.</td></tr>
                        }
                        @foreach (var cred in Model)
                        {
                            <tr>
                                <td>@(cred.ProviderKey == "digipay" ? "دیجی‌پی" : cred.ProviderKey == "snapppay" ? "اسنپ‌پی" : cred.ProviderKey)</td>
                                <td>@(cred.Environment ?? "-")</td>
                                <td>
                                    @if (cred.IsActive)
                                    {
                                        <span class="badge badge-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@cred.Id" class="btn btn-sm btn-info">ویرایش</a>
                                    <form asp-action="Delete" asp-route-id="@cred.Id" method="post" style="display:inline-block;" onsubmit="return confirm('حذف شود؟');">
                                        <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <h5>راهنما</h5>
                    <ul class="small">
                        <li><b>دیجی‌پی:</b> اعتبارنامه از <a href="https://merchant.mydigipay.com" target="_blank" rel="noopener">merchant.mydigipay.com</a> — محیط UAT برای تست، LIVE برای عملیاتی.</li>
                        <li><b>اسنپ‌پی:</b> پس از امضای قرارداد، مستندات محرمانه + اعتبارنامه ارسال می‌شود؛ BaseUrl پیش‌فرض Staging است و در صورت نیاز می‌توانید آدرس اختصاصی بدهید.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
